<?xml version="1.0"?>
<package format="3">
  <name>rl_controller</name>
  <version>0.0.0</version>
  <description>RL Controller for T3 - Go1 Hackathon</description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>TODO</license>

  <!-- Инструмент сборки для Python-пакетов -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Зависимости времени выполнения -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  
  <!-- ВАЖНО: Без этого не будут работать LowState и LowCmd -->
  <depend>unitree_go</depend>

  <!-- Тестовые зависимости (стандартные) -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
